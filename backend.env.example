# Runtime-only settings. Never commit real credentials.
TEM_DATA_DIR=/data
TEM_HOST=0.0.0.0
TEM_PORT=8765
TEM_ALLOWED_ORIGINS=https://YOUR-GITHUB-USER.github.io
# Optional. When omitted, the server generates its own key in settings.json.
# TEM_ADMIN_TOKEN=REPLACE_WITH_A_RANDOM_SECRET
# Online deployment: keep both keys only in the backend hosting dashboard.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_IN_HOSTING_DASHBOARD
# TEM_ADMIN_TOKEN is required when SUPABASE_URL is set.
